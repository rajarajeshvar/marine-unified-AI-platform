# Marine Guardian AI — Environment Configuration
# Copy this file to .env and adjust values as needed.

# LLM
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ChromaDB
CHROMA_COLLECTION_NAME=marine_knowledge

# Retrieval
RETRIEVAL_TOP_K=5

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# API
API_HOST=0.0.0.0
API_PORT=8000

# Memory
MAX_CONVERSATION_TURNS=10
